<Project>
  <PropertyGroup>
    <!-- Path to the game install. Override per-machine in Directory.Build.props.user if yours differs. -->
    <GamePath>D:\SteamLibrary\steamapps\common\Expedition Into Darkness Demo</GamePath>
    <BepInExPath>$(GamePath)\BepInEx</BepInExPath>
  </PropertyGroup>
  <Import Project="Directory.Build.props.user" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.props.user')" />
</Project>
