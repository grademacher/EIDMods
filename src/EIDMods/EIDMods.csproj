<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The loader: the only BepInEx plugin. Rarely changes. It owns the injected host
    MonoBehaviour and hot-reloads EIDMods.Features.dll. Changing THIS project needs a game restart.
  -->
  <Import Project="..\GameReferences.props" />

  <PropertyGroup>
    <AssemblyName>EIDMods</AssemblyName>
    <RootNamespace>EIDMods</RootNamespace>
    <DeployDir>$(BepInExPath)\plugins\EIDMods</DeployDir>
    <DeployLockedHint>The loader can't be hot-reloaded: close the game and build again.</DeployLockedHint>
  </PropertyGroup>

</Project>
